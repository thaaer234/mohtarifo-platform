{% load static %}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>طباعة بطاقات الكود - {{ batch.subject.name }}</title>
    <style>
        @font-face {
            font-family: 'Al-Jazeera-Arabic';
            src: url("{% static 'dashboard/img/card_assets/FONT/ArbFONTS-Al-Jazeera-Arabic-Regular.ttf' %}") format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        @font-face {
            font-family: 'Al-Jazeera-Arabic';
            src: url("{% static 'dashboard/img/card_assets/FONT/ArbFONTS-Al-Jazeera-Arabic-Bold.ttf' %}") format('truetype');
            font-weight: bold;
            font-style: normal;
        }
        body { margin: 0; padding: 0; background-color: #555; font-family: 'Al-Jazeera-Arabic', sans-serif; }
        @page { size: A4; margin: 0; }
        .page-a4 { width: 210mm; height: 297mm; background: white; margin: 0 auto; page-break-after: always; position: relative; overflow: hidden; display: flex; flex-direction: column; }
        .card-container { width: 210mm; height: 99mm; position: relative; border-bottom: 1px dashed #999; }
        .svg-card { width: 100%; height: 100%; display: block; }
        @media print { .no-print { display: none; } body { background: white; } .page-a4 { border: none; box-shadow: none; } }
    </style>
</head>
<body>
<div class="no-print" style="position: fixed; top: 20px; left: 20px; z-index: 1000;">
    <button onclick="window.print()" style="padding: 15px 30px; background: #816537; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: 900; font-family: 'Al-Jazeera-Arabic';">🖨️ طباعة البطاقات الأصلية</button>
</div>
{% for group in grouped_cards %}
<div class="page-a4">
    {% for item in group %}
